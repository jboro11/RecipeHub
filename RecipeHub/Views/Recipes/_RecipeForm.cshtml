@model RecipeHub.Application.ViewModels.RecipeInputModel
<input type="hidden" asp-for="Id" />
<div asp-validation-summary="All" class="text-danger"></div>

<div class="mb-3">
    <label asp-for="Title" class="form-label text-light"></label>
    <input asp-for="Title" class="form-control" placeholder="Např. Kuřecí kari" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="ShortDescription" class="form-label text-light"></label>
    <textarea asp-for="ShortDescription" class="form-control" rows="2" placeholder="Krátký úvod k receptu (nepovinné)"></textarea>
    <span asp-validation-for="ShortDescription" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label text-light"></label>
    <textarea asp-for="Description" class="form-control" rows="5" placeholder="Detailní postup přípravy..."></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="CategoryId" class="form-label text-light"></label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" class="form-select">
            <option value="">-- Vyber kategorii --</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="PrepTime" class="form-label text-light"></label>
        <select asp-for="PrepTime" asp-items="ViewBag.PrepTimes" class="form-select">
            <option value="">-- Zvol časovou náročnost --</option>
        </select>
        <span asp-validation-for="PrepTime" class="text-danger"></span>
    </div>
</div>

<div class="row g-3 mt-2">
    <div class="col-md-6">
        <label asp-for="Difficulty" class="form-label text-light">Obtížnost</label>
        <select asp-for="Difficulty" asp-items="ViewBag.Difficulties" class="form-select"></select>
        <span asp-validation-for="Difficulty" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="ImageUrl" class="form-label text-light"></label>
        <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
        <span asp-validation-for="ImageUrl" class="text-danger"></span>
    </div>
</div>

<hr class="text-secondary mt-4" />
<h5 class="text-light d-flex align-items-center">Ingredience</h5>
<p class="text-muted small mb-2">Přidej název a nepovinné množství. Vyplň alespoň dvě ingredience, další řádky můžeš přidat.</p>
<span asp-validation-for="Ingredients" class="text-danger"></span>

<div id="ingredients-list" class="d-flex flex-column gap-2">
    @for (var i = 0; i < Model.Ingredients.Count; i++)
    {
        <div class="row g-2 ingredient-row align-items-center" data-index="@i">
            <div class="col-md-7">
                <label asp-for="Ingredients[i].Name" class="visually-hidden"></label>
                <input asp-for="Ingredients[i].Name" class="form-control" placeholder="Název ingredience" />
                <span asp-validation-for="Ingredients[i].Name" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Ingredients[i].Quantity" class="visually-hidden"></label>
                <input asp-for="Ingredients[i].Quantity" class="form-control" placeholder="Množství (nepovinné)" />
                <span asp-validation-for="Ingredients[i].Quantity" class="text-danger"></span>
            </div>
            <div class="col-md-1 text-end">
                <button type="button" class="btn btn-outline-danger btn-sm remove-ingredient" title="Odebrat" aria-label="Odebrat ingredienci">&times;</button>
            </div>
        </div>
    }
</div>

<div class="mt-2">
    <button type="button" id="add-ingredient" class="btn btn-outline-warning btn-sm">+ Přidat ingredienci</button>
</div>


<template id="ingredient-template">
    <div class="row g-2 ingredient-row align-items-center" data-index="__idx__">
        <div class="col-md-7">
            <label for="Ingredients___idx____Name" class="visually-hidden">Ingredience</label>
            <input class="form-control" id="Ingredients___idx____Name" name="Ingredients[__idx__].Name" maxlength="100" data-val="true" data-val-required="Název ingredience je povinný." placeholder="Název ingredience" />
            <span data-valmsg-for="Ingredients[__idx__].Name" data-valmsg-replace="true" class="text-danger"></span>
        </div>
        <div class="col-md-4">
            <label for="Ingredients___idx____Quantity" class="visually-hidden">Množství</label>
            <input class="form-control" id="Ingredients___idx____Quantity" name="Ingredients[__idx__].Quantity" maxlength="100" placeholder="Množství (nepovinné)" />
            <span data-valmsg-for="Ingredients[__idx__].Quantity" data-valmsg-replace="true" class="text-danger"></span>
        </div>
        <div class="col-md-1 text-end">
            <button type="button" class="btn btn-outline-danger btn-sm remove-ingredient" title="Odebrat" aria-label="Odebrat ingredienci">&times;</button>
        </div>
    </div>
</template>
